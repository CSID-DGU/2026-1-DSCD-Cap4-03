# This is an example .env file for the ROUPLE Backend application.
APP_NAME=ROUPLE Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# CORS settings
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# S3 settings for image storage
S3_BUCKET=rouple-images-dev
S3_REGION=ap-northeast-2
S3_PREFIX=users
S3_PRESIGN_EXPIRE_SECONDS=900
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_PUBLIC_BASE_URL=
# Database settings
USE_LOCAL_SQLITE=true
DATABASE_URL=
DB_AUTO_CREATE_TABLES=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=Rouple_db

# Skin model settings
SKIN_MODEL_CHECKPOINT=
SKIN_MODEL_DEVICE=cpu
SKIN_MODEL_IMG_SIZE=224
# Neo4j settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# OpenAI API settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
KG_OPENAI_MODEL=gpt-5.4-mini
KG_OPENAI_TIMEOUT_SEC=60
KG_OPENAI_TEMPERATURE=0.6
DGU_LLM_API_KEY=
DGU_LLM_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
DGU_LLM_MODEL=gpt-5.4-nano
DGU_LLM_TEMPERATURE=0.6
DGU_LLM_MAX_TOKENS=5000
DGU_LLM_PRINT_USAGE=true
